# ==============================================================================
# Tallybook Environment Configuration Example
# ==============================================================================

# Supabase Configuration
# Paste your Supabase Project URL and API Key (Anon or Service Role Key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Groq API Key for AI Reasoning Layer (Llama 3.3 70B)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Reconciliation Thresholds
ACCEPT_THRESHOLD=0.80
EXCEPTION_THRESHOLD=0.55
HIGH_VALUE_THRESHOLD=10000.0

# JWT Authentication
JWT_SECRET=tallybook_super_secret_jwt_key_2026_buildathon
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Environment Settings
APP_ENV=development
DATA_DIR=./app/data
