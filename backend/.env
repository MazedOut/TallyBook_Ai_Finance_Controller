# ==============================================================================
# Tallybook Environment Configuration
# ==============================================================================

# Database Persistence (Embedded SQLite 3)
SQLITE_DB_PATH=./app/data/tallybook.db

# Groq API Key for AI Reasoning Layer (Optional)
# Leave blank to automatically use the high-precision deterministic semantic fallback engine
GROQ_API_KEY=

# Reconciliation Thresholds
ACCEPT_THRESHOLD=0.80
EXCEPTION_THRESHOLD=0.55
HIGH_VALUE_THRESHOLD=10000.0

# JWT Authentication
JWT_SECRET=tallybook_super_secret_jwt_key_2026_buildathon
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Environment Settings
APP_ENV=development
DATA_DIR=./app/data
